# ---- Telegram ----
BOT_TOKEN=123456:ABC-DEF...
# Канал: @username або числовий -100xxxxxxxxxx
CHANNEL_ID=@my_english_channel
# Твій Telegram user id (кілька — через кому)
ADMIN_IDS=123456789
TZ=Europe/Kyiv

# ---- AI ----
GEMINI_API_KEY=AIza... або AQ....
AI_MODEL=gemini-3.8-flash
# Запасні моделі, якщо основна віддає 503 (через кому)
AI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash

# ---- Гіфка: пошук реакції-гіфки за змістом/настроєм фрази через GIPHY ----
# Ключ: https://developers.giphy.com/dashboard/ (Create App → API Key)
GIPHY_API_KEY=

# ---- Поведінка ----
# Скільки постів тримати на ревʼю (можна змінити з бота: /schedule)
QUEUE_TARGET=3
LOG_LEVEL=INFO
